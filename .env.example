PORT=5000
MONGO_URI=mongodb://localhost:27017/biomanure_db
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173,https://your-netlify-site.netlify.app
VITE_API_BASE_URL=

# Email Configuration (Options: gmail, brevo, smtp, console)
# Note: For Gmail/Thunderbird integration, set EMAIL_PROVIDER=gmail and obtain a 16-character App Password.
EMAIL_PROVIDER=gmail
EMAIL_FROM_NAME=BioLink Agritech
EMAIL_FROM_ADDRESS=info@biolinkagri.in

GMAIL_USER=info@biolinkagri.in
GMAIL_APP_PASSWORD=your-16-character-google-app-password

BREVO_SMTP_USER=your-brevo-login
BREVO_SMTP_KEY=your-brevo-smtp-key-not-rest-api-key

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# QA Settlement — the URL prefix used in buyer QA clearance emails
SETTLE_BASE_URL=https://your-netlify-site.netlify.app/settle
